# Copy this to .env and fill in real values:  cp .env.example .env
#
# .env is gitignored and must stay that way — it holds live credentials.
# The launchd job gets these baked into its plist by generate_plist.py
# (which writes to ~/Library/LaunchAgents/, not into this folder).
# GitHub Actions gets them from Settings > Secrets and variables > Actions.

# ---------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------
NOTION_TOKEN=secret_xxx
# The 32-hex id from your database's URL. Placeholder on purpose: this
# file is committed to a public repo, and a .example carrying a real
# value is how real values end up committed.
NOTION_DB_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=xxxx
GOOGLE_REFRESH_TOKEN=xxxx
GOOGLE_CALENDAR_ID=primary

# Phone push via ntfy.sh — install the ntfy app and subscribe to this
# exact topic. Treat the topic name like a password: anyone who knows it
# can read (and post to) it on the public server. Use a random string.
NTFY_TOPIC=REPLACE_WITH_A_RANDOM_PRIVATE_TOPIC_NAME

# A SECOND, DIFFERENT random topic — powers the "Mark done" button on
# notifications. Never reuse NTFY_TOPIC here. Optional: leave unset and
# the button is simply absent, nothing breaks. See README "Mark done".
NTFY_COMMAND_TOPIC=

# ---------------------------------------------------------------------
# Cloud-only (GitHub Actions). Not needed for the Mac's launchd job.
# ---------------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-xxxx

# Comma-separated sender domains the Gmail sweep trusts. Put your real
# school's domains in .env, not here — this file is committed to a
# public repo, and there's no reason to publish where you go to school.
SCHOOL_EMAIL_HINTS=yourschool.org,yourdistrict.edu

# ---------------------------------------------------------------------
# Optional — all shown with their built-in defaults.
# ---------------------------------------------------------------------
NTFY_SERVER=https://ntfy.sh

# The wall clock every reminder decision is made against. This must be
# set the same way in .env and in GitHub Actions: without it, cloud runs
# would use UTC and disagree with the Mac about when it's night.
# GOOGLE_CALENDAR_TIMEZONE is used as a fallback if this is unset.
SCHOOL_TIMEZONE=America/Denver
GOOGLE_CALENDAR_TIMEZONE=America/Denver

# No notifications are delivered inside this window. A reminder that
# comes due during quiet hours CONSUMES its slot silently (changed
# 2026-07-30): Last Reminded is stamped, nothing is pushed, and the item
# waits a full interval. It is NOT queued for 05:00 -- doing that fired
# everything held overnight in one burst the moment quiet hours ended.
# Consequence: a Last Reminded timestamp inside this window is normal
# and does not mean a notification was delivered.
QUIET_HOURS_START=00:00
QUIET_HOURS_END=05:00

# Recurring reminder cadence for Assignments and Tasks -- a continuous
# formula, not fixed tiers (changed 2026-07-29). For each type:
#   interval = clamp(alpha * days_until, floor, ceiling) * priority * jitter
# alpha is hours-per-day-remaining; the ceiling is reached (and interval
# stays constant beyond it) at roughly ceiling/alpha days out. Negative
# days_until (overdue) clamps to the floor, and then OVERDUE_DECAY_BASE
# below stretches it further for every day the item stays overdue. See
# shared/reminders.py's module docstring for the full reasoning.
ASSIGNMENT_ALPHA_HOURS_PER_DAY=3.4   # -> ceiling reached ~14 days out
ASSIGNMENT_FLOOR_HOURS=2.0           # overdue rate
ASSIGNMENT_CEILING_HOURS=48.0        # slowest rate, far from due
TASK_ALPHA_HOURS_PER_DAY=24.0        # -> ceiling reached ~3 days out
TASK_FLOOR_HOURS=1.0                 # NOTE: below MIN_INTERVAL_HOURS, so currently inert
TASK_CEILING_HOURS=72.0

# Multiplies the whole interval above (smaller = more frequent). Applies
# to Assignments/Tasks only. Missing or unset Priority defaults to
# Medium (1.0x). NOTE: MIN_INTERVAL_HOURS clamps the result, so High and
# Medium are indistinguishable on a freshly overdue item -- priority
# only changes behavior above the floor.
PRIORITY_MULTIPLIER_HIGH=0.5
PRIORITY_MULTIPLIER_MEDIUM=1.0
PRIORITY_MULTIPLIER_LOW=2.0

# Deterministic per-item randomization (+-25% by default) on top of the
# formula above. Without this, two items due at the same tier stay
# phase-locked forever -- every reminder for both fires together, in the
# same pass, indefinitely. Same item always gets the same jitter.
REMINDER_JITTER_FRACTION=0.25

# Hard cap on how many reminders one pass will send. Extra due items
# aren't lost -- Last Reminded is left untouched, so they're picked up
# on the very next pass (as close as 5 minutes away on the cloud path).
# This is the backstop jitter alone can't cover: adding ten items by
# hand in one sitting.
MAX_NOTIFICATIONS_PER_PASS=3

# --- Overdue back-off (added 2026-07-30) ---
# An overdue item's interval multiplies by OVERDUE_DECAY_BASE for each
# FULL day it stays overdue, until it hits OVERDUE_MAX_INTERVAL_HOURS.
# With the defaults: ~1h on the first day overdue, ~2h on the second,
# ~4h, ~8h, then once a day from about day five on.
#
# This replaced "stay loud forever once overdue," which was a deliberate
# choice and a measurably bad one -- simulated against real items it
# produced 238 pushes in 7 days, 167 of them from ONE stale task
# re-firing every waking hour with identical text. Set the base to 1.0
# to turn decay off and get the old behavior back.
OVERDUE_DECAY_BASE=2.0
OVERDUE_MAX_INTERVAL_HOURS=24.0

# HARD CEILING on notifications delivered in one local day, across every
# item. As of 2026-07-30 this is a TRUE daily total, backed by a real
# per-item count in the Notion "Reminders Today" property (which the sync
# creates and maintains; it dates itself off Last Reminded, so it resets
# at midnight with no cleanup).
#
# It applies to an item's FIRST notification of the day too, not just
# repeats. That is deliberate -- a ceiling that exempts the common case
# is not a ceiling. On a heavy day this can swallow an item's only
# notification; LOAD_SCALE_TARGET_ITEMS below is what keeps it from
# binding often. Nothing is dropped, only deferred to the next pass and
# ultimately to tomorrow's fresh budget.
DAILY_NOTIFICATION_BUDGET=6

# Notification volume was roughly LINEAR in item count: 4 items produced
# ~41 pushes/week, but a realistic 24-item load produced 333/week with a
# peak of 69 in one day -- which is what made turning on Classroom
# capture unshippable.
#
# Every interval is now multiplied by (active items / this number),
# floored at 1x. So a workload at or under this size behaves exactly as
# before, and beyond it each item nags proportionally less, holding total
# volume roughly flat at any item count. Raise it to make a big workload
# noisier, lower it to make it quieter.
LOAD_SCALE_TARGET_ITEMS=5

# THE HARD FLOOR. No item may ever notify twice inside this many hours,
# by any path -- it overrides every other setting in this file.
#
# This was effectively 15 minutes before 2026-07-30, which was not a
# real limit: a High-priority overdue Task took the 1h task floor times
# the 0.5 High multiplier and could fire every THIRTY minutes. Repeat
# notifications stack on iOS and cannot be collapsed, so the only
# defense is not generating them.
#
# Two deliberate consequences, both fine, both easy to trip over later:
#   - TASK_FLOOR_HOURS below this value now does nothing. The old
#     "tasks nag harder than assignments once overdue" distinction is
#     dead at the floor (it still holds further out, via the alphas).
#   - High and Medium priority are identical for a freshly overdue item;
#     both clamp here. Priority still bites above the floor.
MIN_INTERVAL_HOURS=2.0

# Fixed local hour Event reminders (3 days before / 1 day before /
# morning of) go out at, computed from calendar-day difference so a 9pm
# event 3 days out fires at 7am, not at "exactly 72 hours before."
EVENT_REMINDER_HOUR=07:00

# Cloud reminders: cloud_sync fires reminders too, so they still arrive
# while the Mac is asleep. It waits this many minutes before taking over
# so local_sync always gets first crack and nothing fires twice.
# Items captured from Gmail/Classroom skip this wait entirely — they
# didn't exist on local_sync's last pass, so there's no race to lose.
CLOUD_REMINDERS=true
CLOUD_REMINDER_LAG_MINUTES=5

# How far back the Classroom sweep looks. Wider than the 30-minute sync
# interval on purpose, so a day of downtime doesn't lose an assignment;
# duplicates are prevented by the External ID property, not by this.
# Set this large once (8760 = a year) to backfill an existing course.
CLASSROOM_LOOKBACK_HOURS=48

# Explicit overrides when the Classroom -> Notion class matcher gets it
# wrong or can't decide. Format: "Course Name=Notion Option,Other=Option".
# The target must already exist as a Class option in Notion.
CLASS_ALIASES=
