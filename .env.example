# Copy this to .env and fill in real values:  cp .env.example .env
#
# .env is gitignored and must stay that way — it holds live credentials.
# The launchd job gets these baked into its plist by generate_plist.py
# (which writes to ~/Library/LaunchAgents/, not into this folder).
# GitHub Actions gets them from Settings > Secrets and variables > Actions.

# ---------------------------------------------------------------------
# Required
# ---------------------------------------------------------------------
NOTION_TOKEN=secret_xxx
NOTION_DB_ID=6524b82ad7dd499896f4c55a86de9290

GOOGLE_CLIENT_ID=xxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=xxxx
GOOGLE_REFRESH_TOKEN=xxxx
GOOGLE_CALENDAR_ID=primary

# Phone push via ntfy.sh — install the ntfy app and subscribe to this
# exact topic. Treat the topic name like a password: anyone who knows it
# can read (and post to) it on the public server. Use a random string.
NTFY_TOPIC=REPLACE_WITH_A_RANDOM_PRIVATE_TOPIC_NAME

# A SECOND, DIFFERENT random topic — powers the "Mark done" button on
# notifications. Never reuse NTFY_TOPIC here. Optional: leave unset and
# the button is simply absent, nothing breaks. See README "Mark done".
NTFY_COMMAND_TOPIC=

# ---------------------------------------------------------------------
# Cloud-only (GitHub Actions). Not needed for the Mac's launchd job.
# ---------------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-xxxx

# Comma-separated sender domains the Gmail sweep trusts. Put your real
# school's domains in .env, not here — this file is committed to a
# public repo, and there's no reason to publish where you go to school.
SCHOOL_EMAIL_HINTS=yourschool.org,yourdistrict.edu

# ---------------------------------------------------------------------
# Optional — all shown with their built-in defaults.
# ---------------------------------------------------------------------
NTFY_SERVER=https://ntfy.sh

# The wall clock every reminder decision is made against. This must be
# set the same way in .env and in GitHub Actions: without it, cloud runs
# would use UTC and disagree with the Mac about when it's night.
# GOOGLE_CALENDAR_TIMEZONE is used as a fallback if this is unset.
SCHOOL_TIMEZONE=America/Denver
GOOGLE_CALENDAR_TIMEZONE=America/Denver

# No notifications are delivered inside this window. A reminder that
# comes due during quiet hours isn't lost — it fires on the first pass
# afterward.
QUIET_HOURS_START=00:00
QUIET_HOURS_END=05:00

# Recurring reminder cadence for Assignments and Tasks -- a continuous
# formula, not fixed tiers (changed 2026-07-29). For each type:
#   interval = clamp(alpha * days_until, floor, ceiling) * priority * jitter
# alpha is hours-per-day-remaining; the ceiling is reached (and interval
# stays constant beyond it) at roughly ceiling/alpha days out. Negative
# days_until (overdue) clamps to the floor and stays there -- constant
# nagging forever until Status reaches Done, same as before, just no
# longer a special-cased branch. See shared/reminders.py's module
# docstring for the full reasoning, including why Tasks' overdue floor
# is deliberately more aggressive than Assignments'.
ASSIGNMENT_ALPHA_HOURS_PER_DAY=3.4   # -> ceiling reached ~14 days out
ASSIGNMENT_FLOOR_HOURS=2.0           # overdue rate
ASSIGNMENT_CEILING_HOURS=48.0        # slowest rate, far from due
TASK_ALPHA_HOURS_PER_DAY=24.0        # -> ceiling reached ~3 days out
TASK_FLOOR_HOURS=1.0                 # overdue rate -- more aggressive than Assignments on purpose
TASK_CEILING_HOURS=72.0

# Multiplies the whole interval above (smaller = more frequent). Applies
# to Assignments/Tasks only, including their overdue floor. Missing or
# unset Priority on an item defaults to Medium (1.0x).
PRIORITY_MULTIPLIER_HIGH=0.5
PRIORITY_MULTIPLIER_MEDIUM=1.0
PRIORITY_MULTIPLIER_LOW=2.0

# Deterministic per-item randomization (+-25% by default) on top of the
# formula above. Without this, two items due at the same tier stay
# phase-locked forever -- every reminder for both fires together, in the
# same pass, indefinitely. Same item always gets the same jitter.
REMINDER_JITTER_FRACTION=0.25

# Hard cap on how many reminders one pass will send. Extra due items
# aren't lost -- Last Reminded is left untouched, so they're picked up
# on the very next pass (as close as 5 minutes away on the cloud path).
# This is the backstop jitter alone can't cover: the 05:00 quiet-hours
# release, or adding ten items by hand in one sitting.
MAX_NOTIFICATIONS_PER_PASS=3

# Fixed local hour Event reminders (3 days before / 1 day before /
# morning of) go out at, computed from calendar-day difference so a 9pm
# event 3 days out fires at 7am, not at "exactly 72 hours before."
EVENT_REMINDER_HOUR=07:00

# Cloud reminders: cloud_sync fires reminders too, so they still arrive
# while the Mac is asleep. It waits this many minutes before taking over
# so local_sync always gets first crack and nothing fires twice.
# Items captured from Gmail/Classroom skip this wait entirely — they
# didn't exist on local_sync's last pass, so there's no race to lose.
CLOUD_REMINDERS=true
CLOUD_REMINDER_LAG_MINUTES=5

# How far back the Classroom sweep looks. Wider than the 30-minute sync
# interval on purpose, so a day of downtime doesn't lose an assignment;
# duplicates are prevented by the External ID property, not by this.
# Set this large once (8760 = a year) to backfill an existing course.
CLASSROOM_LOOKBACK_HOURS=48

# Explicit overrides when the Classroom -> Notion class matcher gets it
# wrong or can't decide. Format: "Course Name=Notion Option,Other=Option".
# The target must already exist as a Class option in Notion.
CLASS_ALIASES=
